# Copy to .env.local and fill in. Only variables prefixed with VITE_ are exposed to the browser.
# Never put secret keys here — anything prefixed VITE_ ends up in the public JS bundle.

# Where the contact form POSTs JSON. Leave empty to keep the form in "not connected" mode.
# Works with Formspree (https://formspree.io/f/xxxx), Web3Forms, Getform, or your own endpoint.
VITE_CONTACT_ENDPOINT=

# Optional public access key (e.g. Web3Forms access_key). Sent as "access_key" in the payload.
VITE_CONTACT_ACCESS_KEY=

# Public site URL, used for canonical/OG tags reference.
VITE_SITE_URL=https://clitchly.vercel.app
